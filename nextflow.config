/*
 * Zika-Sentinel — Nextflow configuration
 *
 * Modular viral genomic surveillance pipeline for Zika virus (ZIKV).
 * Refactored from GBS-Sentinel; bacterial-specific modules removed.
 *
 * Portable across:
 *   - Local workstations
 *   - Docker (primary validated profile)
 *   - Singularity / Apptainer
 *   - Conda (where environments defined)
 *   - SLURM / generic HPC (combine with docker or singularity)
 *
 * Resource allocation is process-specific via labels.
 * No fixed sample-count limits.
 */

nextflow.enable.dsl = 2


// ============================================================
// Pipeline parameters
// ============================================================

params {

    // --------------------------------------------------------
    // Input pathways (provide exactly one)
    // --------------------------------------------------------
    raw_dir        = false
    sequences      = false
    curated_dir    = false   // alias for sequences

    // Optional metadata TSV/CSV (sample_id as primary key)
    metadata       = false

    // --------------------------------------------------------
    // Output
    // --------------------------------------------------------
    outdir         = "./results"

    // --------------------------------------------------------
    // Reference genome & primers
    // --------------------------------------------------------
    // Default: ZIKV NC_012532.1 (Asian lineage prototype, 10794 bp)
    reference      = "${projectDir}/assets/reference/ZIKV_NC_012532.1.fasta"
    primer_bed     = false   // set only for amplicon datasets with a real BED

    // --------------------------------------------------------
    // Consensus / variant calling thresholds
    // --------------------------------------------------------
    min_depth      = 10
    min_freq       = 0.5
    min_qual       = 20
    mask_depth     = 10

    // --------------------------------------------------------
    // Genome QC thresholds (ZIKV-specific, configurable)
    // --------------------------------------------------------
    qc_min_length_frac = 0.70   // minimum length as fraction of reference
    qc_max_n_frac      = 0.30   // FAIL if N fraction exceeds this
    qc_warn_n_frac     = 0.10   // WARN if N fraction exceeds this

    // --------------------------------------------------------
    // Alignment & phylogeny
    // --------------------------------------------------------
    mafft_opts       = "--auto"
    iqtree_model     = "MFP"
    iqtree_bootstrap = 1000

    // --------------------------------------------------------
    // Nextclade (optional; only if validated for ZIKV)
    // --------------------------------------------------------
    run_nextclade     = false   // disabled until ZIKV dataset support is confirmed
    nextclade_dataset = "zika"

    // --------------------------------------------------------
    // Resource ceilings (process-level)
    // --------------------------------------------------------
    max_cpus       = 8
    max_memory     = "2 GB"

    // --------------------------------------------------------
    // Pipeline identity
    // --------------------------------------------------------
    pipeline_version = "1.1.0"
    help             = false
}


// ============================================================
// Process resource labels
// ============================================================

process {

    stageInMode = 'copy'
    // Container is set only by docker/singularity profiles
    withLabel: 'low_compute' {
        cpus   = 2
        memory = '1 GB'
    }

    withLabel: 'med_compute' {
        cpus   = 4
        memory = '1 GB'
    }

    withLabel: 'high_compute' {
        cpus   = { params.max_cpus as int }
        memory = { params.max_memory }
    }

    errorStrategy = 'terminate'
}


// ============================================================
// Profiles
// ============================================================

profiles {

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        process.container   = 'kizitodevbio/zika-sentinel:1.1.0'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = 'kizitodevbio/zika-sentinel:1.1.0'
    }

    conda {
        conda.enabled = true
    }

    cluster {
        process.executor = 'slurm'
        process.queue    = 'normal'
    }

    test {
        params.max_cpus        = 2
        params.max_memory      = '1 GB'
        params.iqtree_bootstrap = 100
    }

    local {
        process.executor = 'local'
        docker.enabled = false
        singularity.enabled = false
    }
}


// ============================================================
// Execution reports
// ============================================================

timeline {
    enabled   = true
    file      = "${params.outdir}/logs/timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/logs/report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/logs/trace.txt"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.outdir}/logs/dag.svg"
    overwrite = true
}

executor {
    name      = 'local'
    queueSize = 8
}
